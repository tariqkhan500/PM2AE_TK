
# Ignore everything by default
*

# Allow Git to inspect subfolders
!*/

# Include code and notebooks
!*.py
!*.ipynb
!*.sh
!*.cpp
!*.h
!*.cu
!*.cuh

# Include configuration and dependency files
!*.yaml
!*.yml
!*.toml
!*.cfg
!*.ini
!requirements*.txt
!CMakeLists.txt
!.gitignore
!.gitattributes

# Include model checkpoints (stored through Git LFS)
!*.pt
!*.pth
!*.ckpt

# Always exclude generated folders and local settings
**/__pycache__/
**/.ipynb_checkpoints/
Output/
**/results/
training_runs/*
!training_runs/**/
!training_runs/**/*.pt
!training_runs/**/*.pth
!training_runs/**/*.ckpt
.aws/
.codex/
.env*

